{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ydifjusjykeirrljirdg.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "ui-polish-pal",
      "version": "0.1.0",
      "title": "UI Polish Pal"
    },
    "tools": [
      {
        "name": "search_athlete_prices",
        "title": "Search athlete card prices",
        "description": "Find tracked Venezuelan athletes and their latest public raw-card asking prices, stability and listing counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Athlete name or part of a name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10,
              "description": "Maximum athletes returned."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_auctions",
        "title": "Find auctions ending soon",
        "description": "Read public Venezuelan athlete card auctions still open, ordered by ending time; bid values are from the last three-hour refresh.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "athlete": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Optional athlete name or part of a name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10,
              "description": "Maximum auctions returned."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
